{
  "name": "demonode",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --watch-path src src/index.ts",
    "predev": "pnpm build",
    "build": "tsup src/index.ts --format esm --clean",
    "build:watch": "tsup src/index.ts --format esm --watch",
    "prestart": "pnpm build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
